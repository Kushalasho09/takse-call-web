rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read/write to devices collection for device code pairing and telemetry
    match /devices/{deviceCode} {
      allow read: if true; // Required for mobile app to look up connect code before/after pairing
      allow create, update: if true; // Allows web admin to generate codes & mobile app to mark active
      allow delete: if request.auth != null;
    }

    // User profiles & organization members
    match /users/{userId} {
      allow read, write: if true; // Accessible for web dashboard admin & team auth
    }

    // Call logs synchronized from paired mobile devices
    match /call_logs/{logId} {
      allow read: if true; // Web dashboard streams live analytics
      allow create, update: if true; // Mobile SIM background sync writes call logs
      allow delete: if request.auth != null;
    }

    // Organization companies & settings
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
